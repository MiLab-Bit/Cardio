"""
Extension tests — cache, LLM parser.
"""

import json
import shutil
import tempfile
from pathlib import Path

import pytest

from byou.core.llm_parser import parse_llm_json
from byou.infrastructure.cache import CacheLayer


class TestLLMParser:
    """parse_llm_json — the unified JSON extractor."""

    def test_valid_json(self):
        assert parse_llm_json('{"a":1}') == {"a": 1}

    def test_fenced_json(self):
        out = '```json\n{"key":"val"}\n```'
        assert parse_llm_json(out) == {"key": "val"}

    def test_fenced_no_type(self):
        out = '```\n{"x": 2}\n```'
        assert parse_llm_json(out) == {"x": 2}

    def test_nested_braces(self):
        out = 'The output is: {"outer": {"inner": [1,2,3]}} end'
        assert parse_llm_json(out) == {"outer": {"inner": [1, 2, 3]}}

    def test_surrounding_noise(self):
        out = 'Here is the result:\n{\n  "name": "test"\n}\nLet me know if that works.'
        assert parse_llm_json(out) == {"name": "test"}

    def test_empty(self):
        assert parse_llm_json("") == {}

    def test_garbage(self):
        assert parse_llm_json("not json at all") == {"_raw": "not json at all"}

    def test_strict_raises(self):
        with pytest.raises(ValueError):
            parse_llm_json("not json", strict=True)

    def test_list_wrapped(self):
        assert parse_llm_json('[{"a": 1}]') == {"a": 1}

    def test_array_no_dict(self):
        assert parse_llm_json("[1, 2, 3]") == {}


class TestCacheLayer:
    """CacheLayer — multi-level cache (memory + disk)."""

    def _fresh_cache(self, **kwargs):
        """Create cache with a clean temp directory."""
        d = tempfile.mkdtemp()
        return CacheLayer(cache_dir=d, **kwargs), d

    def test_cache_miss(self):
        cache, d = self._fresh_cache()
        assert cache.get("no_such_key") is None
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_hit(self):
        cache, d = self._fresh_cache()
        cache.set("k", [1, 2, 3])
        assert cache.get("k") == [1, 2, 3]
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_delete(self):
        cache, d = self._fresh_cache()
        cache.set("k", "v")
        cache.delete("k")
        assert cache.get("k") is None
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_clear(self):
        cache, d = self._fresh_cache()
        cache.set("a", 1)
        cache.set("b", 2)
        cache.clear()
        assert cache.get("a") is None
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_ttl_expiry(self):
        # TTL=0 means everything expires on the next get
        cache, d = self._fresh_cache(ttl_seconds=0)
        cache.set("x", "val")
        assert cache.get("x") is None
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_lru_eviction_memory_only(self):
        # LRU evicts oldest from memory. Disk fallback can still serve stale
        # entries — use ttl_seconds=0 so all entries (disk too) expire immediately.
        import time
        cache, d = self._fresh_cache(max_size=3, ttl_seconds=0)
        cache.set("a", 1)
        time.sleep(0.02)
        cache.set("b", 2)
        time.sleep(0.02)
        cache.set("c", 3)
        time.sleep(0.02)
        cache.set("d", 4)
        # a is evicted; all entries expired due to TTL=0 anyway
        assert cache.get("a") is None
        # b, c, d also expired
        assert cache.get("b") is None
        assert cache.get("c") is None
        assert cache.get("d") is None
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_lru_count(self):
        # Verify memory entries never exceed max_size
        import time
        cache, d = self._fresh_cache(max_size=3)
        for i in range(10):
            cache.set(f"k{i}", i)
            time.sleep(0.01)
        stats = cache.get_stats()
        assert stats["memory_entries"] <= 3
        shutil.rmtree(d, ignore_errors=True)

    def test_cache_stats(self):
        cache, d = self._fresh_cache()
        cache.set("k1", "v1")
        stats = cache.get_stats()
        assert stats["memory_entries"] == 1
        assert stats["ttl_seconds"] == 3600
        shutil.rmtree(d, ignore_errors=True)


class TestConfig:
    """Unified Settings."""

    def test_defaults(self):
        from byou.config import get_settings

        s = get_settings()
        assert s.log_level == "INFO"
        assert s.max_concurrent_pipelines == 3
        assert s.cache_ttl_seconds == 3600
        assert s.upload_max_bytes == 10 * 1024 * 1024
