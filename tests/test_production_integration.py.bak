_passed = 0
_failed = 0
_current = ""

def section(name: str):
    global _current
    _current = name

def check(cond: bool, msg: str = ""):
    global _passed, _failed, _current
    if cond:
        _passed += 1
        label = f"  [PASS] {_current}: {msg}" if msg else f"  [PASS] {_current}"
        print(label)
    else:
        _failed += 1
        label = f"  [FAIL] {_current}: {msg}" if msg else f"  [FAIL] {_current}"
        print(label)


