def test_structured_logger():
    section("structured logger")
    slog = StructuredLogger(name="test_l6", level="DEBUG")
    slog.set_trace(trace_id="trace_001", run_id="run_001")
    slog.info("test message", stage="extraction", agent="extractor", duration_ms=42.5)
    slog.audit("pipeline_start", {"stages": 5})

    # Key masking
    masked = slog._sanitize("sk-abc123def4567890xyz")
    check("sk-***" in masked, "api key masked")

    slog.clear_trace()
    print("[PASS] structured logger")


def test_metrics():
    section("metrics collector")
    m = MetricsCollector()

    m.pipelines_total.inc({"status": "success"}, 5)
    m.pipelines_total.inc({"status": "failed"}, 1)
    check(m.pipelines_total.get({"status": "success"}) == 5)

    m.stage_duration_ms.observe(120.0)
    m.stage_duration_ms.observe(350.0)
    check(m.stage_duration_ms.avg > 0)

    m.active_pipelines.set(3)
    check(abs(m.active_pipelines.get() - 3.0) < 0.01)

    m.errors_total.inc({"category": "timeout"})
    check(m.errors_total.get({"category": "timeout"}) == 1)

    # Prometheus format
    text = m.prometheus_text()
    check("byou_pipelines_total" in text, "prometheus format")
    check("byou_stage_duration_ms" in text)

    # Snapshot
    snap = m.snapshot()
    check(len(snap.samples) > 0, f"{len(snap.samples)} samples")

    print("[PASS] metrics collector")


def test_health_check():
    section("health check manager")
    mgr = HealthCheckManager()

    # Register quick checks
    mgr.register(FunctionHealthCheck("config", lambda: True))
    mgr.register(FunctionHealthCheck("metrics", lambda: True))

    async def _run():
        status = await mgr.quick()
        check(status.overall == HealthLevel.OK, f"overall={status.overall.value}")
        check(len(status.components) >= 2, f"{len(status.components)} components")
        check(status.uptime_seconds >= 0)
        return status

    status = asyncio.run(_run())
    check(len(status.components) == 2)

    # Degraded test
    mgr.register(FunctionHealthCheck("browser", lambda: False, required=True))
    status2 = asyncio.run(mgr.quick())
    check(status2.overall == HealthLevel.UNHEALTHY, f"unhealthy={status2.overall.value}")

    print("[PASS] health check manager")


# 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?# Phase 2: Shutdown + Reliability + Tracer
# 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?
def test_shutdown():
    section("graceful shutdown")
    sd = GracefulShutdown(timeout_s=5)
    steps_run = []
    sd.register("step1", lambda: steps_run.append("step1"))
    sd.register("step2", lambda: steps_run.append("step2"))

    report = asyncio.run(sd.shutdown())
    check(len(report.steps) == 2)
    check(report.clean, "shutdown clean")
    check(report.total_duration_ms >= 0)  # 鍙兘 <1ms 鎴柇涓?
    check(steps_run == ["step1", "step2"])

    # Timeout test
    sd2 = GracefulShutdown(timeout_s=0.1)
    sd2.register("slow_step", lambda: asyncio.sleep(5), timeout_s=0.05)
    report2 = asyncio.run(sd2.shutdown())
    check(any(s.status == StageStatus.TIMED_OUT for s in report2.steps), "step timed out")

    print("[PASS] graceful shutdown")


def test_reliability():
    section("reliability guards")

    # StageGuard
    async def _test_stage():
        async with StageGuard("test_stage", timeout_s=1, critical=False):
            pass
    asyncio.run(_test_stage())

    # PersistenceGuard
    import tempfile, os
    pg = PersistenceGuard(max_retries=2)
    tmpdir = tempfile.mkdtemp()
    path = os.path.join(tmpdir, "test_save.json")
    result = pg.safe_write(path, '{"hello":"world"}', component="test")
    check(result["success"], f"write OK: {result}")
    check(result["bytes"] > 0)

    # Read back
    with open(path) as f:
        data = json.load(f)
    check(data["hello"] == "world")

    # with_timeout
    async def fast():
        return "ok"
    result = asyncio.run(with_timeout(fast(), timeout_s=1))
    check(result == "ok")

    # with_timeout slow
    async def slow():
        await asyncio.sleep(5)
        return "never"
    result = asyncio.run(with_timeout(slow(), timeout_s=0.01, stage="test"))
    check(isinstance(result, ErrorRecord), f"timeout returns ErrorRecord: {type(result).__name__}")
    check(result.category == ErrorCategory.TIMEOUT)

    # ReliabilityContext
    ctx = get_reliability()
    ctx.open_browser_sessions = 1
    snap = ctx.snapshot()
    check(snap["open_browser_sessions"] == 1)

    print("[PASS] reliability guards")


def test_tracing():
    section("tracer")
    tracer = get_tracer()

    with tracer.span("test_span", trace_id="trace_001", key="val"):
        pass

    spans = tracer.flush()
    check(len(spans) >= 1, f"{len(spans)} spans")

    # PipelineTracer
    pt = PipelineTracer("run_test", "trace_test")
    pt.record_tool_call("tyc_baseinfo", "COMPANY_LOOKUP", 234.5, "success")
    pt.record_tool_call("browser_research", "BROWSER_AUTOMATE", 1500.0, "success")
    s = pt.finish()
    check(len(s) >= 2, f"{len(s)} spans")

    print("[PASS] tracer")


