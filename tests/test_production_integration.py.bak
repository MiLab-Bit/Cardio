def test_config_guard():
    section("config guard")
    g = get_config_guard()

    deps = g.check_deps()
    check(len(deps) > 0, f"{len(deps)} deps checked")

    required = [d for d in deps if not d.optional]
    for d in required:
        check(d.available, f"required dep '{d.dependency}': {d.message}")

    env = g.validate_env()
    check(not env.valid, "env should warn missing keys")

    print("[PASS] config guard")


def test_cost_analyzer():
    section("cost analyzer")
    ca = CostAnalyzer()
    ca.record_llm("gpt-4o", prompt_tokens=500, completion_tokens=200)
    ca.record_llm("gpt-4o", prompt_tokens=300, completion_tokens=150)
    ca.record_tyc("baseinfo")
    ca.record_tyc("court")

    summary = ca.summary()
    check(summary.llm_prompt_tokens == 800)
    check(summary.llm_completion_tokens == 350)
    check(summary.llm_cost_usd > 0, f"llm_cost={summary.llm_cost_usd}")
    check(summary.api_call_count == 2)
    check(summary.api_cost_yuan > 0)
    check(summary.total_cost_usd > 0)

    print("[PASS] cost analyzer")


