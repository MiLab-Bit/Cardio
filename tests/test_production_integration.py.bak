def test_orchestrator_l6():
    section("orchestrator with Observability")
    from byou.core.orchestrator import Orchestrator

    orch = Orchestrator(production=True)
    check(orch._slog is not None, "logger injected")
    check(orch._metrics is not None, "metrics injected")
    check(orch._tracer is not None, "tracer injected")
    check(orch._reliability is not None, "reliability injected")

    # Non-production mode
    orch2 = Orchestrator(production=False)
    check(orch2._slog is None, "no logger in dev mode")
    check(orch2._metrics is None, "no metrics in dev mode")

    print("[PASS] orchestrator with Observability")


