def main():
    global _passed, _failed

    print("=" * 60)
    print("Byou Production 鈥?Integration Tests")
    print("=" * 60)

    print("\n-- Phase 1: Logger + Metrics + Health --")
    test_structured_logger()
    test_metrics()
    test_health_check()

    print("\n-- Phase 2: Shutdown + Reliability + Tracer --")
    test_shutdown()
    test_reliability()
    test_tracing()

    print("\n-- Phase 3: Evaluation + Config + Cost --")
    test_evaluation()
    test_config_guard()
    test_cost_analyzer()

    print("\n-- Phase 4: Orchestrator Integration --")
    test_orchestrator_l6()

    # Summary
    print("\n" + "=" * 60)
    total = _passed + _failed
    print(f"Results: {_passed} passed, {_failed} failed, {total} total")
    if _failed == 0:
        print(">>> ALL PRODUCTION TESTS PASSED <<<")
    else:
        print(f"XXX {_failed} FAILURES XXX")
    print("=" * 60)


if __name__ == "__main__":
    main()
