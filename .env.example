# Cardio 后端环境变量示例（复制为 .env 后填入真实值）
# LLM 网关（abc-ai.cn，OpenAI 兼容）
CARDIO_LLM_BASE_URL=https://www.abc-ai.cn/v1
CARDIO_LLM_API_KEY=sk-xxxx
CARDIO_LLM_MODEL=Qwen-flash

# 多模态视觉模型（名片识别）。默认按需求配 qwen3.5-397b-a17b；
# 若该模型在当前 token 未授权（403 token_model_forbidden），改用网关已授权且支持视觉的模型，
# 例如本网关的 Qwen-flash 已自带视觉能力：
# CARDIO_VISION_MODEL=Qwen-flash
CARDIO_VISION_MODEL=qwen3.5-397b-a17b

# 服务
CARDIO_HOST=0.0.0.0
CARDIO_PORT=8000

# 可选主密钥：留空 = 开放访问（演示）；设置后 /api/* 需要 X-Cardio-Key 头
CARDIO_API_KEY=

# 允许的前端来源（逗号分隔）；留空 = 允许全部
CARDIO_CORS_ORIGINS=https://card-io.pages.dev,https://www.abc-ai.cn

# 数据目录
CARDIO_DATA_DIR=./data
